<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- VirtualDisplay所需权限 -->
    <!-- 注意：VirtualDisplay不需要额外的运行时权限，只需通过MediaProjectionManager请求屏幕录制权限 -->
    
    <!-- 注意：CAPTURE_AUDIO_OUTPUT和CAPTURE_VIDEO_OUTPUT是系统应用专有权限，普通应用无法获取 -->
    
    <!-- VirtualDisplay和MediaProjection不需要外部存储权限 -->
    <!-- 仅通过MediaProjectionManager请求屏幕录制权限 -->

    <!-- 网络相关权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 12+ 媒体投影前台服务类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project_Demo">
        <activity
            android:name=".ScreenCaptureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
    </application>

</manifest>
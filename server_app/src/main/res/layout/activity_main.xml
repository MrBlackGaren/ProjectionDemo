<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sample_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello World!"
                android:textSize="24sp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_change_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修改名称"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@+id/sample_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_change_age" />

            <Button
                android:id="@+id/btn_change_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修改年龄"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_change_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_change_hobby" />

            <Button
                android:id="@+id/btn_change_hobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修改爱好"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_change_age"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_start_native_thread" />

            <Button
                android:id="@+id/btn_start_native_thread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动Native线程"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_change_hobby"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_start_std_threads" />

            <Button
                android:id="@+id/btn_start_std_threads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动Std线程"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_start_native_thread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_modify_static_field" />

            <Button
                android:id="@+id/btn_modify_static_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修改静态字段"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_start_std_threads"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_call_static_method" />

            <Button
                android:id="@+id/btn_call_static_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="调用静态方法"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_modify_static_field"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_virtual_display" />

            <Button
                android:id="@+id/btn_virtual_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VirtualDisplay演示"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_call_static_method"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_screen_capture" />
                
            <Button
                android:id="@+id/btn_screen_capture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ScreenCapture演示"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@+id/btn_virtual_display"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>